        <mxCell id="SCchAOsyZcud_EP7V0Vg-102" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="9" vertex="1">
          <mxGeometry height="30" width="30" x="2036" y="766" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-103" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="1" vertex="1">
          <mxGeometry height="30" width="30" x="221" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-104" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="The user opens the &lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;19&quot;&gt;Browser&lt;/b&gt; and attempts to log in. The browser interacts directly with &lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;87&quot;&gt;Amazon Cognito&lt;/b&gt;. Cognito authenticates the user and issues a secure JSON Web Token (JWT) back to the browser." vertex="1">
          <mxGeometry height="30" width="1180" x="220" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-105" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="2" vertex="1">
          <mxGeometry height="30" width="30" x="221" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-106" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="3" vertex="1">
          <mxGeometry height="30" width="30" x="220" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-107" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="4" vertex="1">
          <mxGeometry height="30" width="30" x="221" y="1615" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-108" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="5" vertex="1">
          <mxGeometry height="30" width="30" x="221" y="1711" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-109" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="6" vertex="1">
          <mxGeometry height="30" width="30" x="221" y="1821" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-110" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="7" vertex="1">
          <mxGeometry height="30" width="30" x="221" y="1908" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-111" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="8" vertex="1">
          <mxGeometry height="30" width="30" x="220" y="1993" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-112" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#C35500;strokeColor=none;gradientDirection=east;fillColor=#FFB300;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="9" vertex="1">
          <mxGeometry height="30" width="30" x="221" y="2093" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-113" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;5&quot;&gt;&lt;br&gt;&lt;/h3&gt;&lt;p data-path-to-node=&quot;6&quot;&gt;The browser requests the web application&#39;s frontend files (HTML, CSS, JS) and hotel images.&lt;/p&gt;&lt;ul data-path-to-node=&quot;7&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,0,0&quot;&gt;This request hits &lt;b data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;18&quot;&gt;Amazon CloudFront&lt;/b&gt;, which is actively shielded by &lt;b data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;67&quot;&gt;AWS WAF&lt;/b&gt; to block malicious traffic (like SQL injections or DDoS attacks).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,1,0&quot;&gt;CloudFront retrieves the requested frontend assets from the &lt;b data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;60&quot;&gt;S3 Static Website&lt;/b&gt; bucket and the images from the &lt;b data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;109&quot;&gt;Hotel Images&lt;/b&gt; bucket. It secures this connection using &lt;b data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;163&quot;&gt;Origin Access Control (OAC)&lt;/b&gt;, ensuring the buckets remain entirely private from the public internet.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="150" width="1177" x="263" y="1336" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-114" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;10&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;The authenticated user performs an action in the UI (e.g., search or book a room). The browser sends an HTTP API request containing the JWT token in the authorization header. This request passes through &lt;/span&gt;&lt;b data-path-to-node=&quot;11&quot; data-index-in-node=&quot;197&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px;&quot;&gt;CloudFront&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt; and targets &lt;/span&gt;&lt;b data-path-to-node=&quot;11&quot; data-index-in-node=&quot;220&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px;&quot;&gt;Amazon API Gateway&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;.&lt;/span&gt;&lt;/h3&gt;&lt;p data-path-to-node=&quot;13&quot;&gt;&lt;b data-path-to-node=&quot;13&quot; data-index-in-node=&quot;0&quot;&gt;API Gateway&lt;/b&gt; intercepts the request and verifies the signature of the JWT token with &lt;b data-path-to-node=&quot;13&quot; data-index-in-node=&quot;84&quot;&gt;Cognito&lt;/b&gt;. Once verified, API Gateway uses a secure &lt;b data-path-to-node=&quot;13&quot; data-index-in-node=&quot;134&quot;&gt;VPC Link&lt;/b&gt; to pass the HTTP traffic over AWS&#39;s private network backbone, bypassing the public internet entirely.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="1105" x="265" y="1486" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-115" parent="1" style="text;whiteSpace=wrap;html=1;" value="The traffic lands on the internal &lt;b data-path-to-node=&quot;15&quot; data-index-in-node=&quot;35&quot;&gt;Application Load Balancer (ALB)&lt;/b&gt; stationed across the private subnets. The ALB analyzes the request path (e.g., &lt;code data-path-to-node=&quot;15&quot; data-index-in-node=&quot;147&quot;&gt;/reservations&lt;/code&gt; or &lt;code data-path-to-node=&quot;15&quot; data-index-in-node=&quot;164&quot;&gt;/search&lt;/code&gt;) and routes the traffic to the corresponding target group inside the &lt;b data-path-to-node=&quot;15&quot; data-index-in-node=&quot;241&quot;&gt;ECS Fargate Cluster&lt;/b&gt;." vertex="1">
          <mxGeometry height="70" width="840" x="270.5" y="1606" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-116" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;18&quot;&gt;Before an ECS container task can process that routed request, it must boot up securely without a NAT Gateway:&lt;/p&gt;&lt;ul data-path-to-node=&quot;19&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;19,0,0&quot;&gt;&lt;b data-path-to-node=&quot;19,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Image Pull:&lt;/b&gt; The ECS agent utilizes the &lt;b data-path-to-node=&quot;19,0,0&quot; data-index-in-node=&quot;39&quot;&gt;ECR Interface Endpoints&lt;/b&gt; (&lt;code data-path-to-node=&quot;19,0,0&quot; data-index-in-node=&quot;64&quot;&gt;api&lt;/code&gt; and &lt;code data-path-to-node=&quot;19,0,0&quot; data-index-in-node=&quot;72&quot;&gt;dkr&lt;/code&gt;) combined with an &lt;b data-path-to-node=&quot;19,0,0&quot; data-index-in-node=&quot;94&quot;&gt;S3 Gateway Endpoint&lt;/b&gt; to securely pull the application Docker image from &lt;b data-path-to-node=&quot;19,0,0&quot; data-index-in-node=&quot;165&quot;&gt;Amazon ECR&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;19,1,0&quot;&gt;&lt;b data-path-to-node=&quot;19,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Credential Fetching:&lt;/b&gt; The container requests database credentials by talking to &lt;b data-path-to-node=&quot;19,1,0&quot; data-index-in-node=&quot;79&quot;&gt;AWS Secrets Manager&lt;/b&gt; via its designated &lt;b data-path-to-node=&quot;19,1,0&quot; data-index-in-node=&quot;118&quot;&gt;Interface Endpoint&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;19,2,0&quot;&gt;&lt;b data-path-to-node=&quot;19,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Logging:&lt;/b&gt; Application runtime logs are instantly streamed out to &lt;b data-path-to-node=&quot;19,2,0&quot; data-index-in-node=&quot;64&quot;&gt;Amazon CloudWatch&lt;/b&gt; via the &lt;b data-path-to-node=&quot;19,2,0&quot; data-index-in-node=&quot;90&quot;&gt;CloudWatch Logs Interface Endpoint&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="140" width="1260" x="265" y="1676" as="geometry" />
        </mxCell>
        <mxCell id="SCchAOsyZcud_EP7V0Vg-117" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;23&quot;&gt;Depending on the user&#39;s action, one of your three core ECS services processes the business logic:&lt;/p&gt;&lt;ul data-path-to-node=&quot;24&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;24,0,0&quot;&gt;&lt;b data-path-to-node=&quot;24,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Search Service:&lt;/b&gt; Queries the &lt;b data-path-to-node=&quot;24,0,0&quot; data-index-in-node=&quot;28&quot;&gt;OpenSearch Service&lt;/b&gt; cluster to find available hotels.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;24,1,0&quot;&gt;&lt;b data-path-to-node=&quot;24,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Reservation Service:&lt;/b&gt; Handles booking creation and room inventory management.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="140" width="1060" x="267" y="1798" as="geometry" />
        </mxCell>
        <mxCell id="ngVDmUoELbAkNXuveCA4-1" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.glue_data_catalog;" value="" vertex="1">
          <mxGeometry height="46.6" width="43" x="2199" y="690.6999999999999" as="geometry" />
        </mxCell>
        <mxCell id="ngVDmUoELbAkNXuveCA4-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=12;container=0;" value="Data &lt;br&gt;Catalog" vertex="1">
          <mxGeometry height="30" width="79" x="2181" y="740.9999999999999" as="geometry" />
        </mxCell>
        <mxCell id="ngVDmUoELbAkNXuveCA4-3" edge="1" parent="1" source="ngVDmUoELbAkNXuveCA4-1" style="endArrow=classic;html=1;rounded=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" target="SCchAOsyZcud_EP7V0Vg-6" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="2250" y="850" as="sourcePoint" />
            <mxPoint x="2300" y="800" as="targetPoint" />
